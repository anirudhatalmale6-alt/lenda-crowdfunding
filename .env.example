# LENDA Platform Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# APPLICATION ENVIRONMENT
# ===========================================
LENDA_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lenda
DB_USERNAME=lenda_user
DB_PASSWORD=your_secure_password_here

# ===========================================
# SECURITY - JWT (SEC-01: CRITICAL)
# ===========================================
# RS256 Keys (recommended for production - generate and paste PEM content)
LENDA_JWT_PRIVATE_KEY=
LENDA_JWT_PUBLIC_KEY=
LENDA_JWT_ALGORITHM=RS256
LENDA_JWT_EXPIRATION=3600

# HS256 alternative (symmetric - less secure)
# LENDA_JWT_SECRET=generate_a_secure_random_string_at_least_32_chars
# LENDA_JWT_ALGORITHM=HS256
# NOTE: In production, JWT secret MUST be set. Application will throw exception if not configured.

# ===========================================
# SECURITY - ENCRYPTION (SEC-10: CRITICAL)
# ===========================================
LENDA_ENCRYPTION_KEY=generate_a_secure_encryption_key_32_chars
# NOTE: Field-level encryption requires this key to be set in production

# ===========================================
# SECURITY - SESSION & AUTH
# ===========================================
LENDA_SESSION_SECRET=your_session_secret_key
LENDA_TOTP_ISSUER=LENDA

# ===========================================
# CORS SETTINGS
# ===========================================
LENDA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# BLOCKCHAIN CONFIGURATION (if applicable)
# ===========================================
WEB3_PROVIDER_URL=http://localhost:8545
WEB3_CHAIN_ID=1
WEB3_GAS_LIMIT=500000

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# KYC Service
KYC_API_URL=https://api.kyc-provider.com
KYC_API_KEY=your_kyc_api_key
KYC_WEBHOOK_SECRET=your_webhook_secret

# Email Service
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@lenda.com

# SMS Service
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://api.sms-provider.com

# ===========================================
# CACHE CONFIGURATION
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300

# ===========================================
# PAYMENT GATEWAYS
# ===========================================
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# ===========================================
# RESERVE FUND CONFIGURATION (FIN-02: FIXED)
# ===========================================
# Minimum reserve fund balance - used as fallback when DB is empty
# Set to match your expected portfolio size (default: 100,000)
RESERVE_FUND_MINIMUM=100000
# Target reserve fund level for full platform coverage
RESERVE_FUND_TARGET=5000000
RESERVE_FUND_COVERAGE_RATIO=0.10

# ===========================================
# FEE CONFIGURATION (FIN-01: FIXED)
# ===========================================
# Origination fee percentage (charged on loan amount)
ORIGINATION_FEE_PERCENT=2.0
# Platform fee percentage
PLATFORM_FEE_PERCENT=0.5
# Late payment fee percentage
LATE_FEE_PERCENT=1.0

# ===========================================
# RISK ENGINE CONFIGURATION
# ===========================================
RISK_DEFAULT_THRESHOLD=0.30
RISK_HIGH_THRESHOLD=0.50
RISK_LTV_MAX=70
RISK_EXPOSURE_MAX_PERCENT=5

# ===========================================
# PERFORMANCE & SCALING
# ===========================================
WORKER_PROCESSES=4
MAX_CONNECTIONS=1000
QUERY_CACHE_SIZE=128

# ===========================================
# MONITORING & LOGGING
# ===========================================
LOG_LEVEL=debug
SENTRY_DSN=
